{
  "name": "all-hands-arcade",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source, extensible multiplayer party game platform for large teams and enterprise events.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/core"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "gen": "turbo run gen",
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  }
}
